---
import Layout from "@/layouts/Layout.astro"

import AboutMe from "@/components/AboutMe.astro"
import CodeIcon from "@/components/icons/Code.astro"
import ProfileCheck from "@/components/icons/ProfileCheck.astro"
import Projects from "@/components/Projects.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Hero from "@/components/Hero.astro"
import TitleSection from "@/components/TitleSection.astro"
import Skills from "@/components/Skills.astro"
import Brain from "@/components/icons/Brain.astro"
import Contact from "@/components/Contact.astro"
import Mail from "@/components/icons/Mail.astro"
import Experience from "@/components/Experience.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import Languages from "@/components/Languages.astro"
import Globe from "@/components/icons/Globe.astro"
---

<Layout
  title="Portfolio de Rodriguez Lucas - Desarrollador Full-Stack"
  description="Portfolio de Lucas Gonzalo Rodriguez, Técnico en Programación Informática egresado de la UNSAM. Desarrollador full-stack con experiencia en Kotlin, Spring Boot, React, TypeScript, PostgreSQL, MongoDB y más. Ayudante de Cátedra en UNSAM. En búsqueda de su primer puesto como desarrollador."
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36" id="inicio">
      <Hero />
    </SectionContainer>

    <div class="space-y-24">
    <SectionContainer id="experiencia">
      <TitleSection>
        <Briefcase class="size-7" />
        Experiencia
      </TitleSection>
      <Experience />
    </SectionContainer>

    <SectionContainer id="habilidades">
      <TitleSection>
        <Brain class="size-7" />
        Habilidades
      </TitleSection>
      <Skills />
    </SectionContainer>

    <SectionContainer id="idiomas">
      <TitleSection>
        <Globe class="size-7" />
        Idiomas
      </TitleSection>
      <Languages />
    </SectionContainer>

    <SectionContainer id="proyectos">
      <TitleSection>
        <CodeIcon class="size-7" />
        Proyectos
      </TitleSection>
      <Projects />
    </SectionContainer>

    <SectionContainer id="sobre-mi">
      <TitleSection>
        <ProfileCheck class="size-7" />
        Sobre mí
      </TitleSection>
      <AboutMe />
    </SectionContainer>

    <SectionContainer id="contacto">
      <TitleSection>
        <Mail class="size-7" />
        Contacto
      </TitleSection>
      <Contact />
    </SectionContainer>
  </div>
  </main>
</Layout>
