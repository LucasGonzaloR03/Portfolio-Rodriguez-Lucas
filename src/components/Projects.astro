---
import GitHub from "./icons/GitHub.astro"
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import Kotlin from "./icons/Kotlin.astro"
import PostgreSQL from "./icons/PostgreSQL.astro"
import MongoDB from "./icons/MongoDB.astro"
import Redis from "./icons/Redis.astro"
import Neo4j from "./icons/Neo4j.astro"
import TypeScript from "./icons/TypeScript.astro"
import CSSIcon from "./icons/CSS.astro"
import MaterialUI from "./icons/MaterialUI.astro"
import React from "./icons/React.astro"
import Python from "./icons/Python.astro"
import Go from "./icons/Go.astro"
import LinkButton from "./LinkButton.astro"
import Nodejs from "./icons/Nodejs.astro"
import Docker from "./icons/Docker.astro"
import { Image } from "astro:assets"

const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  CSS: {
    name: "CSS",
    class: "bg-[#264de4] text-white",
    icon: CSSIcon,
  },
  REACT: {
    name: "React",
    class: "bg-[#282C34] text-white",
    icon: React,
  },
  KOTLIN: {
    name: "Kotlin",
    class: "bg-[#0095D5] text-white",
    icon: Kotlin,
  },
  GO: {
    name: "Go",
    class: "bg-[#00ADD8] text-white",
    icon: Go,
  },
  POSTGRESQL: {
    name: "PostgreSQL",
    class: "bg-[#336791] text-white",
    icon: PostgreSQL,
  },
  MONGODB: {
    name: "MongoDB",
    class: "bg-[#47A248] text-white",
    icon: MongoDB,
  },
  REDIS: {
    name: "Redis",
    class: "bg-[#DD0000] text-white",
    icon: Redis,
  },
  NEO4J: {
    name: "Neo4j",
    class: "bg-[#00BDB3] text-white",
    icon: Neo4j,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    class: "bg-[#3178c6] text-white",
    icon: TypeScript,
  },
  PYTHON: {
    name: "Python",
    class: "bg-[#3776AB] text-white",
    icon: Python,
  },
  MATERIALUI: {
    name: "Material UI",
    class: "bg-[#1976D2] text-white",
    icon: MaterialUI,
  },
    NODE: {
    name: "Node.js",
    class: "bg-[#339933] text-white",
    icon: Nodejs,
  },
  DOCKER: {
    name: "Docker",
    class: "bg-[#2496ED] text-white",
    icon: Docker,
  },
}
const PROJECTS = [
  {
    title: "Uberto Backend — Plataforma de reservas de viajes",
    description: "API REST en Kotlin/Spring Boot que gestiona usuarios, choferes y viajes en tiempo real. Combina cuatro bases de datos: PostgreSQL para datos transaccionales, MongoDB para perfiles de usuario, Redis para cachear rutas frecuentes y Neo4j para recomendaciones basadas en grafos. Incluye autenticación con Spring Security y arquitectura modular por capas.",
    github: "https://github.com/LucasGonzaloR03/Uberto-Backend-PHM-UNSAM",
    image: "/projects/uberto-backend.webp",
    tags: [TAGS.KOTLIN, TAGS.POSTGRESQL, TAGS.MONGODB, TAGS.REDIS, TAGS.NEO4J],
  },
  {
    title: "Uberto Frontend — Interfaz web para gestión de viajes",
    description: "SPA en React + TypeScript que consume la API REST de Uberto. Permite administrar usuarios, choferes y viajes con una interfaz responsiva construida con Material UI. Implementa manejo de estado, llamadas asíncronas a la API, testing de componentes y separación clara entre lógica y presentación.",
    github: "https://github.com/LucasGonzaloR03/Uberto-Frontend-PHM-UNSAM",
    image: "/projects/uberto-frontend.webp",
    tags: [TAGS.REACT, TAGS.TYPESCRIPT, TAGS.MATERIALUI, TAGS.CSS],
  },
  {
    title: "MusicAr — Gestión de equipos musicales",
    description: "Aplicación en Kotlin para modelar grupos musicales con roles, instrumentos y contratos. El foco estuvo en el diseño orientado a objetos: herencia, polimorfismo, colecciones tipadas y cobertura con tests unitarios. Proyecto académico que sirvió como base de mi formación en diseño de dominio.",
    github: "https://github.com/LucasGonzaloR03/MusicAr-Algoritmos-II-UNSAM",
    image: "/projects/musicAr.webp",
    tags: [TAGS.KOTLIN],
  },
  {
    title: "Expectativa de Inflación en Argentina (2017–2023)",
    description: "Herramienta en Python para calcular y visualizar expectativas de inflación usando datos históricos del INDEC. Implementa algoritmos de optimización numérica con SciPy y genera gráficos interactivos con Matplotlib y NumPy. Presentado como trabajo práctico en Matemática III.",
    github: "https://github.com/LucasGonzaloR03/Trabajo-Practico-N-1-Matematica-III-UNSAM",
    image: "/projects/expectativa inflacionaria.webp",
    tags: [TAGS.PYTHON],
  },
  {
    title: "Predicción de Cambio Climático en Buenos Aires",
    description: "Análisis de 30 años de datos meteorológicos de Buenos Aires (1991–2023) con modelos de regresión y predicción. Identifica tendencias de temperatura, precipitaciones y humedad. Usa Pandas para el procesamiento, Scikit-Learn para los modelos predictivos y Matplotlib para visualización interactiva.",
    github: "https://github.com/LucasGonzaloR03/Trabajo-Practico-N-2-Matematica-III-UNSAM",
    image: "/projects/cambio climatico.webp",
    tags: [TAGS.PYTHON],
  },
  {
    title: "Canales en Go — Concurrencia con Goroutines",
    description: "Implementación de patrones clásicos de concurrencia en Go: Productor-Consumidor, pipelines con buffers y sincronización entre goroutines mediante canales. El proyecto explora los trade-offs entre canales con y sin buffer, y cómo evitar deadlocks. Trabajo práctico del Seminario de Programación en UNSAM.",
    github: "https://github.com/LucasGonzaloR03/Trabajo-Practico-de-Canales-Seminario-de-Programacion-UNSAM",
    image: "/projects/canales.webp",
    tags: [TAGS.GO],
  },
  {
    title: "Image Tool — Procesamiento de imágenes con microservicios",
    description: "Aplicación web para subir, mejorar y eliminar el fondo de imágenes. Arquitectura de microservicios: un servicio Node.js maneja las peticiones del frontend en React, mientras un microservicio Python procesa las imágenes con remoción de fondo automática. Todo orquestado con Docker Compose.",
    github: "https://github.com/LucasGonzaloR03/image-tool",
    image: "/projects/image-tool.webp",
    tags: [TAGS.NODE, TAGS.PYTHON, TAGS.REACT, TAGS.DOCKER],
  },
]
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, github }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative h-full flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
            
            <Image
              src={image}
              alt={`Captura de pantalla: ${title}`}
              width={600}
              height={400}
              inferSize
              class="object-cover object-top w-full h-full transition duration-500 md:scale-110 md:group-hover:scale-105"
              loading="lazy"
            />

          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {title}
          </h3>

          <div class="flex flex-wrap mt-2">
            <ul class="grid grid-cols-3 gap-2 mb-2">
              {tags?.map((tag) => (
                <li class="w-full">
                  <span
                    class={`flex items-center justify-center gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 w-full`}
                  >
                    <tag.icon class="size-4" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-200">
              {description}
            </div>

            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-6" />
                  Código
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
