---
import GitHub from "./icons/GitHub.astro"
import Globe from "./icons/Globe.astro"
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import Kotlin from "./icons/Kotlin.astro"
import PostgreSQL from "./icons/PostgreSQL.astro"
import MongoDB from "./icons/MongoDB.astro"
import Redis from "./icons/Redis.astro"
import Neo4j from "./icons/Neo4j.astro"
import TypeScript from "./icons/TypeScript.astro"
import CSSIcon from "./icons/CSS.astro"
import MaterialUI from "./icons/MaterialUI.astro"
import React from "./icons/React.astro"
import Python from "./icons/Python.astro"
import Go from "./icons/Go.astro"
import LinkButton from "./LinkButton.astro"
import Nodejs from "./icons/Nodejs.astro"
import Docker from "./icons/Docker.astro"
import { Image } from "astro:assets"

const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  CSS: {
    name: "CSS",
    class: "bg-[#264de4] text-white",
    icon: CSSIcon,
  },
  REACT: {
    name: "React",
    class: "bg-[#282C34] text-white",
    icon: React,
  },
  KOTLIN: {
    name: "Kotlin",
    class: "bg-[#0095D5] text-white",
    icon: Kotlin,
  },
  GO: {
    name: "Go",
    class: "bg-[#00ADD8] text-white",
    icon: Go,
  },
  POSTGRESQL: {
    name: "PostgreSQL",
    class: "bg-[#336791] text-white",
    icon: PostgreSQL,
  },
  MONGODB: {
    name: "MongoDB",
    class: "bg-[#47A248] text-white",
    icon: MongoDB,
  },
  REDIS: {
    name: "Redis",
    class: "bg-[#DD0000] text-white",
    icon: Redis,
  },
  NEO4J: {
    name: "Neo4j",
    class: "bg-[#00BDB3] text-white",
    icon: Neo4j,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    class: "bg-[#3178c6] text-white",
    icon: TypeScript,
  },
  PYTHON: {
    name: "Python",
    class: "bg-[#3776AB] text-white",
    icon: Python,
  },
  MATERIALUI: {
    name: "Material UI",
    class: "bg-[#1976D2] text-white",
    icon: MaterialUI,
  },
    NODE: {
    name: "Node.js",
    class: "bg-[#339933] text-white",
    icon: Nodejs,
  },
  DOCKER: {
    name: "Docker",
    class: "bg-[#2496ED] text-white",
    icon: Docker,
  },
}
const PROJECTS = [
  {
    title: "Uberto Backend — Plataforma de reservas de viajes",
    description: "API REST en Kotlin/Spring Boot que gestiona usuarios, choferes y viajes en tiempo real. Combina cuatro bases de datos: PostgreSQL para datos transaccionales, MongoDB para perfiles de usuario, Redis para cachear rutas frecuentes y Neo4j para recomendaciones basadas en grafos. Incluye autenticación con Spring Security y arquitectura modular por capas.",
    github: "https://github.com/LucasGonzaloR03/Uberto-Backend-Deploy",
    image: "/projects/uberto-backend.webp",
    tags: [TAGS.KOTLIN, TAGS.POSTGRESQL, TAGS.MONGODB, TAGS.REDIS, TAGS.NEO4J],
  },
  {
    title: "Uberto Frontend — Interfaz web para gestión de viajes",
    description: "SPA en React + TypeScript que consume la API REST de Uberto. Permite administrar usuarios, choferes y viajes con una interfaz responsiva construida con Material UI. Implementa manejo de estado, llamadas asíncronas a la API, testing de componentes y separación clara entre lógica y presentación.",
    github: "https://github.com/LucasGonzaloR03/Uberto-Frontend-Deploy",
    live: "https://uberto-frontend-deploy.vercel.app/",
    image: "/projects/uberto-frontend.webp",
    tags: [TAGS.REACT, TAGS.TYPESCRIPT, TAGS.MATERIALUI, TAGS.CSS],
  },
  {
    title: "MusicAr — Gestión de equipos musicales",
    description: "Aplicación en Kotlin para modelar grupos musicales con roles, instrumentos y contratos. El foco estuvo en el diseño orientado a objetos: herencia, polimorfismo, colecciones tipadas y cobertura con tests unitarios. Proyecto académico que sirvió como base de mi formación en diseño de dominio.",
    github: "https://github.com/LucasGonzaloR03/MusicAr-Algoritmos-II-UNSAM",
    image: "/projects/musicAr.webp",
    tags: [TAGS.KOTLIN],
  },
  {
    title: "Expectativa de Inflación en Argentina (2017–2023)",
    description: "Herramienta en Python para calcular y visualizar expectativas de inflación usando datos históricos del INDEC. Implementa algoritmos de optimización numérica con SciPy y genera gráficos interactivos con Matplotlib y NumPy. Presentado como trabajo práctico en Matemática III.",
    github: "https://github.com/LucasGonzaloR03/Trabajo-Practico-N-1-Matematica-III-UNSAM",
    image: "/projects/expectativa inflacionaria.webp",
    tags: [TAGS.PYTHON],
  },
  {
    title: "Predicción de Cambio Climático en Buenos Aires",
    description: "Análisis de 30 años de datos meteorológicos de Buenos Aires (1991–2023) con modelos de regresión y predicción. Identifica tendencias de temperatura, precipitaciones y humedad. Usa Pandas para el procesamiento, Scikit-Learn para los modelos predictivos y Matplotlib para visualización interactiva.",
    github: "https://github.com/LucasGonzaloR03/Trabajo-Practico-N-2-Matematica-III-UNSAM",
    image: "/projects/cambio climatico.webp",
    tags: [TAGS.PYTHON],
  },
  {
    title: "Canales en Go — Concurrencia con Goroutines",
    description: "Implementación de patrones clásicos de concurrencia en Go: Productor-Consumidor, pipelines con buffers y sincronización entre goroutines mediante canales. El proyecto explora los trade-offs entre canales con y sin buffer, y cómo evitar deadlocks. Trabajo práctico del Seminario de Programación en UNSAM.",
    github: "https://github.com/LucasGonzaloR03/Trabajo-Practico-de-Canales-Seminario-de-Programacion-UNSAM",
    image: "/projects/canales.webp",
    tags: [TAGS.GO],
  },
  {
    title: "Image Tool — Procesamiento de imágenes con microservicios",
    description: "Aplicación web para subir, mejorar y eliminar el fondo de imágenes. Arquitectura de microservicios: un servicio Node.js maneja las peticiones del frontend en React, mientras un microservicio Python procesa las imágenes con remoción de fondo automática. Todo orquestado con Docker Compose.",
    github: "https://github.com/LucasGonzaloR03/image-tool",
    image: "/projects/image-tool.webp",
    tags: [TAGS.NODE, TAGS.PYTHON, TAGS.REACT, TAGS.DOCKER],
  },
]
const englishCopy = [
  ["Uberto Backend — Ride booking platform", "Kotlin/Spring Boot REST API for managing users, drivers, and rides in real time. It combines four databases: PostgreSQL for transactional data, MongoDB for user profiles, Redis to cache frequently used routes, and Neo4j for graph-based recommendations. Includes Spring Security authentication and a layered modular architecture."],
  ["Uberto Frontend — Web interface for ride management", "React + TypeScript single-page app that consumes the Uberto REST API. It lets users manage riders, drivers, and trips through a responsive Material UI interface. Includes state management, asynchronous API calls, component testing, and a clear separation between logic and presentation."],
  ["MusicAr — Music group management", "Kotlin application for modeling music groups, roles, instruments, and contracts. The focus was object-oriented design: inheritance, polymorphism, typed collections, and unit test coverage. This academic project helped shape my foundation in domain design."],
  ["Inflation Expectations in Argentina (2017–2023)", "Python tool for calculating and visualizing inflation expectations using historical INDEC data. It implements numerical optimization algorithms with SciPy and creates interactive charts with Matplotlib and NumPy. Submitted as coursework for Mathematics III."],
  ["Climate Change Forecasting in Buenos Aires", "Analysis of 30 years of weather data for Buenos Aires (1991–2023) using regression and forecasting models. The project identifies temperature, rainfall, and humidity trends, using Pandas for data processing, Scikit-Learn for predictive models, and Matplotlib for visualization."],
  ["Go Channels — Concurrency with Goroutines", "Implementation of classic Go concurrency patterns: producer-consumer, buffered pipelines, and goroutine synchronization with channels. Explores the trade-offs of buffered and unbuffered channels and ways to avoid deadlocks. Coursework for UNSAM’s Programming Seminar."],
  ["Image Tool — Image processing with microservices", "Web application for uploading, enhancing, and removing backgrounds from images. A Node.js service handles requests from a React frontend, while a Python microservice processes images and automatically removes backgrounds. Orchestrated with Docker Compose."],
]
const portugueseCopy = [
  ["Uberto Backend — Plataforma de reserva de viagens", "API REST em Kotlin/Spring Boot para gerenciar usuários, motoristas e viagens em tempo real. Combina quatro bancos de dados: PostgreSQL para dados transacionais, MongoDB para perfis de usuário, Redis para armazenar rotas frequentes em cache e Neo4j para recomendações baseadas em grafos. Inclui autenticação com Spring Security e arquitetura modular em camadas."],
  ["Uberto Frontend — Interface web para gestão de viagens", "Aplicação de página única em React + TypeScript que consome a API REST do Uberto. Permite gerenciar passageiros, motoristas e viagens por meio de uma interface responsiva feita com Material UI. Inclui gerenciamento de estado, chamadas assíncronas à API, testes de componentes e separação entre lógica e apresentação."],
  ["MusicAr — Gestão de grupos musicais", "Aplicação em Kotlin para modelar grupos musicais, funções, instrumentos e contratos. O foco foi o design orientado a objetos: herança, polimorfismo, coleções tipadas e cobertura de testes unitários. Projeto acadêmico que contribuiu para minha formação em design de domínio."],
  ["Expectativa de inflação na Argentina (2017–2023)", "Ferramenta em Python para calcular e visualizar expectativas de inflação usando dados históricos do INDEC. Implementa algoritmos de otimização numérica com SciPy e gera gráficos interativos com Matplotlib e NumPy. Trabalho apresentado na disciplina Matemática III."],
  ["Previsão de mudanças climáticas em Buenos Aires", "Análise de 30 anos de dados meteorológicos de Buenos Aires (1991–2023) com modelos de regressão e previsão. Identifica tendências de temperatura, precipitação e umidade. Usa Pandas no processamento, Scikit-Learn nos modelos preditivos e Matplotlib na visualização."],
  ["Canais em Go — Concorrência com Goroutines", "Implementação de padrões clássicos de concorrência em Go: produtor-consumidor, pipelines com buffers e sincronização de goroutines por canais. Explora as diferenças entre canais com e sem buffer e como evitar deadlocks. Trabalho prático do Seminário de Programação da UNSAM."],
  ["Image Tool — Processamento de imagens com microsserviços", "Aplicação web para enviar, melhorar e remover o fundo de imagens. Um serviço Node.js recebe as solicitações do frontend em React, enquanto um microsserviço em Python processa as imagens e remove fundos automaticamente. Tudo é orquestrado com Docker Compose."],
]
const { lang = "es" } = Astro.props
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, github, live }, index) => (
      (() => { const [displayTitle, displayDescription] = lang === "en" ? englishCopy[index] : lang === "pt" ? portugueseCopy[index] : [title, description]; return (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative h-full flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
            
            <Image
              src={image}
              alt={lang === "en" ? `Screenshot: ${displayTitle}` : lang === "pt" ? `Imagem do projeto: ${displayTitle}` : `Captura de pantalla: ${displayTitle}`}
              width={600}
              height={400}
              inferSize
              class="object-cover object-top w-full h-full transition duration-500 md:scale-110 md:group-hover:scale-105"
              loading="lazy"
            />

          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {displayTitle}
          </h3>

          <div class="flex flex-wrap mt-2">
            <ul class="grid grid-cols-3 gap-2 mb-2">
              {tags?.map((tag) => (
                <li class="w-full">
                  <span
                    class={`flex items-center justify-center gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 w-full`}
                  >
                    <tag.icon class="size-4" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-200">
              {displayDescription}
            </div>

            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-6" />
                  {lang === "en" ? "Source code" : lang === "pt" ? "Código-fonte" : "Código"}
                </LinkButton>
              )}
              {live && (
                <LinkButton href={live}>
                  <Globe class="size-6" />
                  {lang === "en" ? "View live" : lang === "pt" ? "Ver online" : "Ver en vivo"}
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
      ) })()
    ))
  }
</div>
