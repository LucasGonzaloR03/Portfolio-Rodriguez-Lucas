---
interface ExperienceItem {
  title: string
  company: string
  period: string
  description: string[]
}

const experiences: ExperienceItem[] = [
  {
    title: "Ayudante de Cátedra — Algoritmos 3",
    company: "Universidad Nacional de San Martín (UNSAM)",
    period: "Agosto 2025 — Noviembre 2025",
    description: [
      "Asistencia docente en la materia de desarrollo web full-stack (frontend y backend).",
      "Guía a estudiantes en tecnologías como React, TypeScript, Node.js y diseño de APIs REST.",
      "Corrección de trabajos prácticos y evaluación de proyectos finales.",
    ],
  },
  {
    title: "Tutor — Algoritmos 3 y Programación con Herramientas Modernas (PHM)",
    company: "Universidad Nacional de San Martín (UNSAM)",
    period: "Marzo 2026 — Presente",
    description: [
      "Tutoría en desarrollo web full-stack (frontend y backend) para Algoritmos 3 y en bases de datos relacionales y no relacionales (PostgreSQL, MongoDB, Redis) para PHM.",
      "Acompaño a estudiantes en React, TypeScript, Node.js, Spring Boot y Docker, y en el diseño de APIs REST.",
      "Resuelvo consultas técnicas y guío a los estudiantes en el desarrollo de sus proyectos finales.",
    ],
  },
]
const { lang = "es" } = Astro.props
const english: ExperienceItem[] = [
  { title: "Teaching Assistant — Algorithms 3", company: "National University of San Martín (UNSAM)", period: "August 2025 — November 2025", description: ["Teaching support for a full-stack web development course covering frontend and backend.", "Guide students in React, TypeScript, Node.js, and REST API design.", "Review assignments and assess final projects."] },
  { title: "Tutor — Algorithms 3 and Programming with Modern Tools (PHM)", company: "National University of San Martín (UNSAM)", period: "March 2026 — Present", description: ["Tutoring in full-stack web development (frontend and backend) for Algorithms 3 and in relational and non-relational databases (PostgreSQL, MongoDB, Redis) for PHM.", "Guide students in React, TypeScript, Node.js, Spring Boot, and Docker, as well as REST API design.", "Answer technical questions and support students throughout their final projects."] },
]
const items = lang === "en" ? english : experiences
const portuguese: ExperienceItem[] = [
  { title: "Auxiliar de Ensino — Algoritmos 3", company: "Universidade Nacional de San Martín (UNSAM)", period: "Agosto 2025 — Novembro 2025", description: ["Apoio ao ensino em disciplina de desenvolvimento web full-stack, com conteúdo de frontend e backend.", "Oriento estudantes em React, TypeScript, Node.js e design de APIs REST.", "Corrijo trabalhos práticos e avalio projetos finais."] },
  { title: "Tutor — Algoritmos 3 e Programação com Ferramentas Modernas (PHM)", company: "Universidade Nacional de San Martín (UNSAM)", period: "Março 2026 — Presente", description: ["Tutoria em desenvolvimento web full-stack (frontend e backend) em Algoritmos 3 e em bancos de dados relacionais e não relacionais (PostgreSQL, MongoDB, Redis) em PHM.", "Oriento estudantes em React, TypeScript, Node.js, Spring Boot e Docker, além do design de APIs REST.", "Respondo a dúvidas técnicas e acompanho os projetos finais dos estudantes."] },
]
const displayItems = lang === "pt" ? portuguese : items
---

<div class="flex flex-col gap-y-12">
  {
    displayItems.map((exp) => (
      <article class="flex flex-col md:flex-row gap-6 md:gap-10">
        <div class="md:w-1/3 flex flex-col gap-1">
          <span class="text-sm text-yellow-600 dark:text-yellow-400 font-mono font-semibold">
            {exp.period}
          </span>
          <span class="text-xs text-gray-500 dark:text-gray-400 leading-snug">
            {exp.company}
          </span>
        </div>
        <div class="md:w-2/3">
          <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-2">
            {exp.title}
          </h3>
          <ul class="flex flex-col gap-1">
            {exp.description.map((item) => (
              <li class="text-gray-600 dark:text-gray-300 text-sm flex gap-2">
                <span class="text-yellow-500 mt-1">▹</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))
  }
</div>
